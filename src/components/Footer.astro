---
import { SITE } from '../config';

const jaar = new Date().getFullYear();
---

<footer class="mt-24 border-t border-oak-200 bg-oak-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-3">
    <div>
      <p class="font-serif text-lg">{SITE.naam}</p>
      <p class="mt-2 text-sm text-oak-700">{SITE.tagline}</p>
    </div>

    <div class="text-sm text-oak-800">
      <p class="font-medium text-bark-900">Contact</p>
      <ul class="mt-3 space-y-1">
        <li><a href={SITE.telefoonHref} class="hover:text-oak-600">{SITE.telefoon}</a></li>
        <li><a href={`mailto:${SITE.email}`} class="hover:text-oak-600">{SITE.email}</a></li>
        <li>{SITE.plaats}</li>
        <li>{SITE.regio}</li>
      </ul>
    </div>

    <div class="text-sm text-oak-800">
      <p class="font-medium text-bark-900">Gegevens</p>
      <ul class="mt-3 space-y-1">
        <li>KVK {SITE.kvk}</li>
        <li>BTW {SITE.btw}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-oak-200 px-6 py-5">
    <p class="mx-auto max-w-6xl text-xs text-oak-600">&copy; {jaar} {SITE.naam}</p>
  </div>
</footer>
