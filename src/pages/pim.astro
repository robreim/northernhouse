---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Photo from '../components/Photo.astro';
import { PIM, SITE } from '../config';
---

<BaseLayout
  title={`Over Pim — ${SITE.naam}`}
  description="Pim is de timmerman achter Northern House. Buiten het werk vind je hem in de natuur."
>
  <Header />

  <main>
    <section class="mx-auto max-w-3xl px-6 pt-14 pb-16 md:pt-20">
      <p class="text-xs tracking-[0.2em] text-oak-600 uppercase">Over Pim</p>
      <h1 class="mt-5 font-serif text-4xl leading-[1.1] text-balance text-bark-900 sm:text-5xl">
        {PIM.teksten.kop}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-oak-800">
        {PIM.teksten.intro}
      </p>
    </section>

    <section class="border-y border-oak-200 bg-oak-100">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <h2 class="font-serif text-3xl text-bark-900 sm:text-4xl">{PIM.teksten.buiten_kop}</h2>

        <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {
            PIM.interesses.map((i) => (
              <li class="border-t border-oak-300 pt-4">
                <h3 class="font-serif text-xl text-bark-900">{i.titel}</h3>
                <p class="mt-2 text-sm leading-relaxed text-oak-800">{i.tekst}</p>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-16 font-serif text-2xl text-bark-900">{PIM.teksten.onderweg_kop}</h3>
        <ul class="mt-6 grid gap-6 sm:grid-cols-3">
          {
            PIM.onderweg.map((f) => (
              <li>
                <Photo src={f.foto} alt={f.alt} ratio="aspect-[3/4]" sizes="(min-width: 640px) 33vw, 100vw" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-6 py-20">
      <h2 class="font-serif text-3xl text-bark-900">{PIM.teksten.cta_kop}</h2>
      <p class="mt-4 leading-relaxed text-oak-800">
        {PIM.teksten.cta_tekst}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/#contact" class="bg-oak-700 px-6 py-3 text-sm text-oak-50 transition-colors hover:bg-oak-800">
          {PIM.teksten.cta_contact}
        </a>
        <a href="/#projecten" class="border border-oak-300 px-6 py-3 text-sm text-bark-900 transition-colors hover:bg-oak-100">
          {PIM.teksten.cta_projecten}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
