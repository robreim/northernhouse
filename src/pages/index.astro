---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Photo from '../components/Photo.astro';
import ContactForm from '../components/ContactForm.astro';
import { DIENSTEN, HOME, PROJECTEN, SITE } from '../config';
---

<BaseLayout
  title={`${SITE.naam} — ${SITE.tagline}`}
  description={SITE.beschrijving}
>
  <Header />

  <main id="top">
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-6 pt-14 pb-20 md:pt-20">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <p class="text-xs tracking-[0.2em] text-oak-600 uppercase">
            {SITE.tagline}
          </p>
          <h1 class="mt-5 font-serif text-4xl leading-[1.1] text-balance text-bark-900 sm:text-5xl md:text-6xl">
            {HOME.hero.kop}
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-oak-800">
            {HOME.hero.intro}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a
              href="#contact"
              class="bg-oak-700 px-6 py-3 text-sm text-oak-50 transition-colors hover:bg-oak-800"
            >
              {HOME.hero.knop_contact}
            </a>
            <a
              href="#projecten"
              class="border border-oak-300 px-6 py-3 text-sm text-bark-900 transition-colors hover:bg-oak-100"
            >
              {HOME.hero.knop_projecten}
            </a>
          </div>
        </div>

        <Photo
          src={HOME.hero.foto}
          alt={HOME.hero.alt}
          ratio="aspect-[4/5]"
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="eager"
        />
      </div>
    </section>

    <!-- Projecten -->
    <section id="projecten" class="border-y border-oak-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <header class="max-w-2xl">
          <h2 class="font-serif text-3xl text-bark-900 sm:text-4xl">{HOME.projecten.kop}</h2>
          <p class="mt-4 text-oak-800">{HOME.projecten.intro}</p>
        </header>

        <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {
            PROJECTEN.map((project) => (
              <li>
                <a href={`/projecten/${project.slug}`} class="group block">
                  <Photo src={project.cover} alt={project.alt} class="transition-opacity group-hover:opacity-90" />
                  <h3 class="mt-4 font-serif text-lg text-bark-900 group-hover:text-oak-600">
                    {project.label}
                  </h3>
                  <p class="mt-1 text-sm text-oak-800">{project.tekst}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Diensten -->
    <section id="diensten">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <header class="max-w-2xl">
          <h2 class="font-serif text-3xl text-bark-900 sm:text-4xl">{HOME.diensten.kop}</h2>
          <p class="mt-4 text-oak-800">{HOME.diensten.intro}</p>
        </header>

        <ul class="mt-12 grid gap-10 sm:grid-cols-2">
          {
            DIENSTEN.map((dienst) => (
              <li class="grid gap-6 sm:grid-cols-[1fr_1.2fr] sm:items-start">
                <Photo src={dienst.foto} alt={dienst.alt} ratio="aspect-square" sizes="(min-width: 640px) 25vw, 100vw" />
                <div>
                  <h3 class="font-serif text-xl text-bark-900">{dienst.titel}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-oak-800">
                    {dienst.tekst}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Over -->
    <section id="over" class="border-y border-oak-200 bg-oak-100">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2">
        <Photo
          src={HOME.over.foto}
          alt={HOME.over.alt}
          ratio="aspect-[4/5]"
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <div>
          <h2 class="font-serif text-3xl text-bark-900 sm:text-4xl">{HOME.over.kop}</h2>
          <p class="mt-5 leading-relaxed text-oak-800">{HOME.over.tekst1}</p>
          <p class="mt-4 leading-relaxed text-oak-800">{HOME.over.tekst2}</p>
          <p class="mt-6">
            <a href="/pim" class="border border-oak-300 bg-oak-50 px-6 py-3 text-sm text-bark-900 transition-colors hover:bg-white">
              {HOME.over.knop}
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-16">
          <div>
            <h2 class="font-serif text-3xl text-bark-900 sm:text-4xl">{HOME.contact.kop}</h2>
            <p class="mt-4 text-oak-800">{HOME.contact.tekst1}</p>
            <p class="mt-4 text-oak-800">{HOME.contact.tekst2}</p>

            <dl class="mt-9 text-sm">
              <dt class="text-xs tracking-widest text-oak-600 uppercase">Werkgebied</dt>
              <dd class="mt-1 text-oak-800">{SITE.regio}</dd>
            </dl>
          </div>

          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
